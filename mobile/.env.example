# Copy to .env.local (git-ignored) and adjust. EXPO_PUBLIC_* values are bundled into the app and
# are public by definition: never put secrets here. Restart Metro after changing
# (npm run start -- --clear if cached).
#
# Leave empty to use the defaults:
#   web / iOS simulator:  http://localhost:5165
#   Android emulator:     http://10.0.2.2:5165
#
# Physical phone (Expo Go): use your PC's LAN IP, e.g. http://192.168.1.20:5165
# The API must listen on 0.0.0.0 and the firewall must allow inbound port 5165.
EXPO_PUBLIC_API_URL=
